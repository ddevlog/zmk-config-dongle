#include <zephyr/dt-bindings/gpio/gpio.h>

&spi3 {
    status = "okay";
    cs-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;

    st7789: st7789v@0 {
        compatible = "sitronix,st7789v";
        reg = <0>;
        spi-max-frequency = <20000000>;
        cmd-data-gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
        reset-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
        width = <240>;
        height = <240>;
        x-offset = <0>;
        y-offset = <0>;
        // Опционально, но часто требуется:
        rgb-order = <0>;      // 0 = RGB, 1 = BRG и т.д.
        // invert-display;    // раскомментировать, если цвета инвертированы
    };
};

/ {
    chosen {
        zmk,display = &st7789;
    };
};