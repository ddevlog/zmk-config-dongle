#include <zephyr/dt-bindings/gpio/gpio.h>

&spi3 {
    status = "okay";
    cs-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;

    st7789: st7789v@0 {
        compatible = "sitronix,st7789v";
        reg = <0>;
        spi-max-frequency = <4000000>;
        cmd-data-gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
        reset-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
        backlight-gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
        mipi-mode = "command";
        write-only;
        width = <240>;
        height = <284>;
        x-offset = <0>;
        y-offset = <18>;
        colmod = <0x05>;
        mdac = <0x00>;
        // остальные параметры драйвер возьмёт по умолчанию
    };
};

/ {
    chosen {
        zmk,display = &st7789;
    };
};