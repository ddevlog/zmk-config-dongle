&pinctrl {
    // Определяем конфигурацию для spi0
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 22)>,    // SCL -> P0.22
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>;   // SDA -> P0.17
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 22)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>;
            low-power-enable;
        };
    };
};

&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";

    mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        status = "okay";
        dc-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;    // DC -> P0.03
        reset-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;  // RES -> P0.02
        spi-dev = <&spi0>;
        #address-cells = <1>;
        #size-cells = <0>;

        st7789: st7789@0 {
            compatible = "sitronix,st7789v";
            reg = <0>;
            status = "okay";
            mipi-max-frequency = <20000000>;
            mipi-mode = "MIPIDBI_MODE_SPI4";
            width = <240>;
            height = <240>;
        };
    };
};
