#include <zephyr/dt-bindings/gpio/gpio.h>

&spi3 {
    status = "okay";
    cs-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;

    st7789: st7789v@0 {
        compatible = "sitronix,st7789v";
        reg = <0>;
        spi-max-frequency = <20000000>;
        cmd-data-gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
        reset-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;

        width = <240>;
        height = <284>;
        x-offset = <0>;
        y-offset = <18>;

        /* === Обязательные параметры из драйвера === */
        vcom = <0x20>;
        gctrl = <0x14>;
        // vrhs и vdvs опциональны, но драйвер их читает
        vrhs = <0x0B>;
        vdvs = <0x20>;
        mdac = <0x00>;
        gamma = <0x01>;
        colmod = <0x05>;
        lcm = <0x2C>;

        /* === Массивы параметров (обязательны) === */
        porch-param = [0c 0c 00 33 33];
        cmd2en-param = [00 00 00 00];   // 4 байта, как в драйвере
        pwctrl1-param = [a4 a1];
        pvgam-param = [d0 04 0d 11 13 2b 3f 55 50 09 12 16 1c 22];
        nvgam-param = [d0 04 0c 11 13 2c 3f 55 50 09 12 16 1c 22];
        ram-param = [00 00];            // RAM Control
        rgb-param = [00 00 00];         // RGB Control

        /* === Опционально, если нужно === */
        // invert-display;
        // rgb-order = <0>;
    };
};

/ {
    chosen {
        zmk,display = &st7789;
    };
};