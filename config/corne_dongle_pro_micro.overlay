/ {
    pwm_leds {
        compatible = "pwm-leds";
        status = "okay";

        // КОД ИЩЕТ ИМЕННО ЭТУ МЕТКУ: disp_bl
        disp_bl: pwm_led_0 {
            pwms = <&pwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
            label = "Backlight PWM";
        };
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 22)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 22)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>;
            low-power-enable;
        };
    };
    pwm0_default: pwm0_default {
            group1 {
                psels = <NRF_PSEL(PWM_OUT0, 0, 5)>; // Используем P0.05 как пример пина BLK
            };
        };
    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 5)>;
            low-power-enable;
        };
    };
};

// Полностью освобождаем ресурсы SPI0
&i2c0 { status = "disabled"; };

&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";

    // CS на P1.06 (пин 38)
    cs-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;

    st7789: st7789@0 {
        compatible = "sitronix,st7789v";
        label = "DISPLAY";
        reg = <0>;
        spi-max-frequency = <20000000>;

        // Пины управления
        cmd-data-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>; // DC -> P0.03
        reset-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;    // RES -> P0.02

        width = <240>;
        height = <240>;
        x-offset = <0>;
        y-offset = <0>;

        // Эти параметры ОБЯЗАТЕЛЬНЫ для прохождения проверки porch-param
        vcom = <0x19>;
        gctrl = <0x35>;
        vrhs = <0x12>;
        vdvs = <0x20>;
        mdac = <0x00>;
        gamma = <0x01>;
        colmod = <0x05>;
        lcm = <0x2c>;

        // Расширенные параметры инициализации (решают вашу ошибку)
        porch-param = [0c 0c 00 33 33];
        cmd2en-param = [5a 69 02 01];
        pwctrl1-param = [a4 a1];
        pvgam-param = [d0 04 0d 11 13 2b 3f 54 4c 18 0d 0b 1f 23];
        nvgam-param = [d0 04 0c 11 13 2c 3f 44 51 2f 1f 1f 20 23];
        ram-param = [00 f0];
        rgb-param = [cd 08 14];
    };
};

/ {
    chosen {
        zephyr,display = &st7789;
    };
};
