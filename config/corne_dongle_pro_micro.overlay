&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-names = "default";

    // Создаем виртуальное устройство DBI на шине SPI
    mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        status = "okay";
        dc-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>; // DC пин (P0.03)
        reset-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>; // RES пин (P0.02)
        spi-dev = <&spi0>;
        #address-cells = <1>;
        #size-cells = <0>;

        st7789: st7789@0 {
            compatible = "sitronix,st7789v";
            reg = <0>;
            status = "okay";
            mipi-max-frequency = <20000000>; // Частота шины

            // ВОТ ЭТО ИСПРАВЛЯЕТ ВАШУ ОШИБКУ:
            mipi-mode = "MIPIDBI_MODE_SPI4";

            width = <240>;
            height = <240>;

            // Если цвета инвертированы (черный стал белым), добавьте это:
            // inversion-on;
        };
    };
};

/ {
    chosen {
        zephyr,display = &st7789;
    };
};
