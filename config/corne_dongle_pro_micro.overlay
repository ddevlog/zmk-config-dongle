&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 22)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 22)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>;
            low-power-enable;
        };
    };
};

&i2c0 { status = "disabled"; };

&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";

    // CS на P1.06
    cs-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;

    lcd: st7789@0 {
        compatible = "sitronix,st7789v";
        label = "DISPLAY";
        reg = <0>;
        spi-max-frequency = <20000000>;

        // В версии v0.3 пины DC и RESET указываются здесь:
        cmd-data-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>; // DC
        reset-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;    // RES

        width = <240>;
        height = <240>;
        x-offset = <0>;
        y-offset = <0>;

        // Базовая инициализация для v0.3
        vcom = <0x19>;
        gctrl = <0x35>;
        vrhs = <0x12>;
        vdvs = <0x20>;
        mdac = <0x00>;
        gamma = <0x01>;
        colmod = <0x05>;
        lcm = <0x2c>;
    };
};

/ {
    chosen {
        zephyr,display = &lcd;
    };
};
